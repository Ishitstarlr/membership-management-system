# ==============================================================================
# ACM NITK Membership Management System - Environment Configuration
# ==============================================================================

# Database Connection (defaults to local SQLite if omitted)
# For PostgreSQL: postgresql://username:password@localhost:5432/acm_membership
DATABASE_URL=sqlite:///./membership.db

# JWT Secret Key (Generate a random 32+ character string in production)
JWT_SECRET=development-secret-key-change-in-production-acm-nitk-2026

# Allowed CORS Origins (comma-separated, default: * for local dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
